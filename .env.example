# رابط الموقع بعد النشر (لصور المشاركة)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ============ Supabase ============
# من Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# سري جدًا — يُستخدم فقط داخل السيرفر (API Routes). لا تضعه أبدًا بمتغير يبدأ بـ NEXT_PUBLIC
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============ الدخول ============
# سلسلة عشوائية طويلة (32 حرفًا أو أكثر) لتوقيع كوكي الدخول
# لتوليدها: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_JWT_SECRET=change-me-to-a-long-random-string

# ============ مصادر الاستيراد (اختياري) ============
# https://developer.themoviedb.org → API Read Access Token
TMDB_API_TOKEN=
# https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=
